# Zomoroda AI System Environment Variables
PORT=3000
NODE_ENV=development
BASE_URL=https://zomoroda-ai-system.vercel.app

# Commerce: use separate databases and credentials for staging and production.
# Production fails closed if either Turso value is missing.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development only; sql.js file has a single process owner.
COMMERCE_DB_PATH=.runtime/commerce.db
STORE_ADMIN_SESSION_SECRET=
# 32+ random characters; encrypts staff TOTP secrets. Back up separately.
STAFF_MFA_KEY=
# Explicit flat delivery fee in piastres. Set 0 for free shipping.
SHIPPING_FEE_MINOR=0
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# 32+ random characters; keep in the backup secret vault.
BACKUP_ENCRYPTION_KEY=
# Set temporarily for npm run staff:create, then remove.
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_NAME=
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_STAFF_TOTP_SECRET=
BOOTSTRAP_STAFF_ROLE=admin
# Optional model drafting. Disabled until explicitly configured and reviewed.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_CALL_LIMIT=0
AI_ALLOW_CUSTOMER_TEXT=false

# SMTP Email Configuration
SMTP_HOST=mail.beautyhealtheg.com
SMTP_PORT=465
SMTP_USER=a.farag@beautyhealtheg.com
SMTP_PASS=your_smtp_password_here

# Meta & WhatsApp Webhook Tokens
META_VERIFY_TOKEN=zomoroda_meta_verify_token
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

