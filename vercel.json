{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/sql.js/dist/**",
          "assets/**",
          "views/**",
          "lib/**",
          "scripts/whacka_products.json",
          "scripts/store_product_images.json"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
